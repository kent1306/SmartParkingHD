    {
        "id": "8d11017eb1b58705",
        "type": "function",
        "z": "ac59c6010bb5f57e",
        "name": "validate parking event",
        "func": "const data = msg.payload;\n\n// Check required fields\nif (!data.parkingID ||\n    !data.slotID ||\n    !data.deviceID ||\n    !data.status ||\n    !data.timestamp ||\n    !data.sensorStatus)\n{\n    node.warn(\"Rejected: Missing required field\");\n    return null;\n}\n\n// Check parking status\nif (data.status !== \"occupied\" &&\n    data.status !== \"available\")\n{\n    node.warn(\"Rejected: Invalid parking status\");\n    return null;\n}\n\n// If occupied, a plate number should exist\nif (data.status === \"occupied\" && !data.plateNumber)\n{\n    node.warn(\"Rejected: Occupied space has no plate number\");\n    return null;\n}\n\n// --------------------------------\n// Duplicate and outdated detection\n// --------------------------------\n\nconst currentTimestamp =\n    Date.parse(msg.payload.timestamp);\n\nif (isNaN(currentTimestamp))\n{\n    node.warn(\"Rejected: Invalid timestamp\");\n    return null;\n}\n\n\n// Each parking slot remembers its latest accepted event\nconst eventKey =\n    `lastEvent_${msg.payload.parkingID}_${msg.payload.slotID}`;\n\nconst lastEvent =\n    flow.get(eventKey);\n\n\n// Create a simple signature for duplicate detection\nconst eventSignature =\n    JSON.stringify({\n        timestamp: msg.payload.timestamp,\n        status: msg.payload.status,\n        plateNumber: msg.payload.plateNumber || null,\n        sensorStatus: msg.payload.sensorStatus\n    });\n\n\nif (lastEvent)\n{\n    // Same event received again\n    if (eventSignature === lastEvent.signature)\n    {\n        node.warn(\n            `Rejected: Duplicate event for ${msg.payload.slotID}`\n        );\n\n        return null;\n    }\n\n\n    // Event timestamp is older than the latest accepted event\n    if (currentTimestamp <= lastEvent.timestamp)\n    {\n        node.warn(\n            `Rejected: Outdated event for ${msg.payload.slotID}`\n        );\n\n        return null;\n    }\n}\n\n\n// Remember the latest valid event\nflow.set(\n    eventKey,\n    {\n        timestamp: currentTimestamp,\n        signature: eventSignature\n    }\n);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
