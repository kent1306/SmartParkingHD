    {
        "id": "bc11075c704d780a",
        "type": "function",
        "z": "ac59c6010bb5f57e",
        "name": "parking status",
        "func": "const data = msg.payload;\n\n// Get current slot states from flow memory\nlet parkingSpaces = flow.get(\"parkingSpaces\") || {};\n\n// Update the latest state of this slot\nparkingSpaces[data.slotID] = data.status;\n\n// Save updated states\nflow.set(\"parkingSpaces\", parkingSpaces);\n\n// Calculate totals\nconst totalSpaces = Object.keys(parkingSpaces).length;\n\nlet occupiedSpaces = 0;\n\nfor (const slotID in parkingSpaces)\n{\n    if (parkingSpaces[slotID] === \"occupied\")\n    {\n        occupiedSpaces++;\n    }\n}\n\nconst availableSpaces = totalSpaces - occupiedSpaces;\n\n// Create new output\nmsg.payload =\n{\n    parkingID: data.parkingID,\n    totalSpaces: totalSpaces,\n    occupiedSpaces: occupiedSpaces,\n    availableSpaces: availableSpaces\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
